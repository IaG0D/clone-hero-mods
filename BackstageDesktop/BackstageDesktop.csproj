<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Backstage.Desktop</RootNamespace>
    <AssemblyName>Backstage</AssemblyName>
    <Version>0.12.45</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Motor compartilhado por FONTE (mesma decisao dos mods: um artefato por app). -->
  <ItemGroup>
    <Compile Include="..\Backstage\ChorusClient.cs" />
    <Resource Include="icon.ico" />
    <Resource Include="Assets\App\*" />
    <Resource Include="Assets\Highways\*" />
    <Resource Include="Assets\Skins\**\*" />
  </ItemGroup>

</Project>
