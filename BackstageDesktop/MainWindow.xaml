<Window x:Class="Backstage.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backstage — by IaG0D" Icon="icon.ico" Height="760" Width="1180" MinWidth="940" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- busca + filtros -->
            <RowDefinition Height="*"/>     <!-- resultados -->
            <RowDefinition Height="Auto"/>  <!-- rodape -->
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="18,12" BorderBrush="{StaticResource GoldDim}" BorderThickness="0,0,0,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontSize="20" FontWeight="Bold">
                    <Run Text="♪ BACKSTAGE" Foreground="{StaticResource Gold}"/>
                    <Run Text="  busca e download · Chorus Encore" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Dim}"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="by IaG0D" Foreground="{StaticResource Dim}"/>
            </DockPanel>
        </Border>

        <!-- busca + filtros -->
        <Grid Grid.Row="1" Margin="18,14,18,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="FieldCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="10,0,0,0" Width="130" SelectedIndex="0"/>
            <ComboBox x:Name="InstCombo" Grid.Column="2" Style="{StaticResource DarkCombo}" Margin="8,0,0,0" Width="140" SelectedIndex="0"/>
            <ComboBox x:Name="DiffCombo" Grid.Column="3" Style="{StaticResource DarkCombo}" Margin="8,0,0,0" Width="120" SelectedIndex="0"/>
            <Button x:Name="SearchBtn" Grid.Column="4" Style="{StaticResource GoldButton}" Margin="10,0,0,0"
                    Content="Buscar" Click="SearchBtn_Click"/>
        </Grid>

        <!-- resultados -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="18,6,18,6" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="Scroller_ScrollChanged">
            <ItemsControl x:Name="Results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Panel}" CornerRadius="8" Margin="0,3" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- capa -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{StaticResource Input}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,48,48" RadiusX="6" RadiusY="6"/>
                                    </Border.Clip>
                                    <Image Source="{Binding ArtUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- musica / artista -->
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Artist, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Genre, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- charter -->
                                <TextBlock Grid.Column="2" Text="{Binding Charter}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis"/>

                                <!-- voce tem? -->
                                <TextBlock Grid.Column="3" Text="{Binding OwnedText}" VerticalAlignment="Center"
                                           Foreground="{Binding OwnedBrush}" FontSize="12" FontWeight="SemiBold"/>

                                <!-- dif / tempo -->
                                <TextBlock Grid.Column="4" Text="{Binding DiffText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{StaticResource Gold}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="5" Text="{Binding LengthText}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Dim}" FontSize="12"/>

                                <!-- previa -->
                                <Button Grid.Column="6" Style="{StaticResource GoldButton}" Padding="8,5" Margin="0,0,8,0"
                                        Content="♪ prévia" FontSize="12" Click="Preview_Click"/>

                                <!-- baixar -->
                                <Button Grid.Column="7" Style="{StaticResource GoldButton}" Padding="14,5"
                                        Content="{Binding DownloadText}" FontSize="12" Click="Download_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- rodape -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="18,10" BorderBrush="#2A3648" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="DlBar" Grid.Row="0" Grid.ColumnSpan="2" Height="6" Margin="0,0,0,8"
                             Background="{StaticResource Input}" Foreground="{StaticResource Gold}"
                             BorderThickness="0" Visibility="Collapsed"/>

                <Button x:Name="ScanBtn" Grid.Row="1" Grid.Column="0" Style="{StaticResource GoldButton}"
                        Content="Escanear no jogo" Click="Scan_Click"/>
                <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                           Text="digite a busca e aperte Enter · ✔ este = já tem este chart · ≈ tem = tem por outro charter"/>
            </Grid>
        </Border>
    </Grid>
</Window>
