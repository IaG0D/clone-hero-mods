<Window x:Class="Backstage.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backstage — by IaG0D" Icon="icon.ico"
        Width="1584" Height="992" MinWidth="1180" MinHeight="720"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Image Source="Assets/App/backstage-shell-v2.jpg" Stretch="UniformToFill"
               Opacity=".74" IsHitTestVisible="False"/>
        <Border Background="#87060A0F" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sidebar fiel ao mockup -->
            <Border Grid.Column="0" Background="#F0091119" BorderBrush="#5B5F5944"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#46515C" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0,0,0">
                            <Image Source="Assets/App/backstage-mark-v2.png" Width="47" Height="32"
                                   Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="BACKSTAGE" Foreground="{StaticResource Gold}"
                                       FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,15,0,0">
                        <RadioButton x:Name="MusicNav" GroupName="Sections" Tag="{StaticResource IconMusic}"
                                     Content="Músicas" Style="{StaticResource NavItem}"
                                     IsChecked="True" Checked="MusicNav_Checked"/>
                        <RadioButton x:Name="HighwayNav" GroupName="Sections" Tag="{StaticResource IconHighway}"
                                     Content="Highways" Style="{StaticResource NavItem}"
                                     Checked="HighwayNav_Checked"/>
                        <RadioButton x:Name="BackgroundNav" GroupName="Sections" Tag="{StaticResource IconImage}"
                                     Content="Backgrounds" Style="{StaticResource NavItem}"
                                     Checked="BackgroundNav_Checked"/>
                        <RadioButton x:Name="SkinNav" GroupName="Sections" Tag="{StaticResource IconPalette}"
                                     Content="Skins" Style="{StaticResource NavItem}"
                                     Checked="SkinNav_Checked"/>
                        <RadioButton x:Name="PresetNav" GroupName="Sections" Tag="{StaticResource IconSettings}"
                                     Content="Presets" Style="{StaticResource NavItem}"
                                     Checked="PresetNav_Checked"/>
                        <RadioButton x:Name="DownloadsNav" GroupName="Sections" Tag="{StaticResource IconDownload}"
                                     Content="Downloads" Style="{StaticResource NavItem}"
                                     Checked="DownloadsNav_Checked"/>
                    </StackPanel>

                    <Button Grid.Row="2" Background="Transparent" BorderThickness="0"
                            Foreground="#8F99A4" Cursor="Hand" Click="OpenRootFolder_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="22,0,0,0">
                            <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                <Path Data="{StaticResource IconSettings}" Stroke="#8995A0"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="Configurações" FontSize="13" Foreground="#8995A0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- área principal -->
            <Grid Grid.Column="1" Margin="28,0,28,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="by IaG0D" Foreground="#A6B0BA" FontSize="12"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="StatusText" Text="Backstage pronto"
                                   Foreground="#6F7C89" FontSize="10" HorizontalAlignment="Right"
                                   MaxWidth="620" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- MÚSICAS -->
                <Grid x:Name="MusicView" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="174"/>
                    </Grid.RowDefinitions>

                    <Border Background="#E80C141D" BorderBrush="#4B5965"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="128"/>
                                <ColumnDefinition Width="148"/>
                                <ColumnDefinition Width="148"/>
                                <ColumnDefinition Width="148"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Grid.Column="0"
                                     Style="{StaticResource SearchBox}"
                                     Tag="Buscar no Chorus Encore"
                                     KeyDown="SearchBox_KeyDown"/>
                            <Button x:Name="SearchBtn" Grid.Column="1" Style="{StaticResource GoldButton}"
                                    Content="Buscar" Height="44" Padding="12,0"
                                    Margin="8,0,0,0" Click="SearchBtn_Click"/>
                            <ComboBox x:Name="FieldCombo" Grid.Column="2" Style="{StaticResource DarkCombo}"
                                      Margin="8,0,0,0" SelectedIndex="0"/>
                            <ComboBox x:Name="InstCombo" Grid.Column="3" Style="{StaticResource DarkCombo}"
                                      Margin="8,0,0,0" SelectedIndex="0"/>
                            <ComboBox x:Name="DiffCombo" Grid.Column="4" Style="{StaticResource DarkCombo}"
                                      Margin="8,0,0,0" SelectedIndex="0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,6,0">
                        <TextBlock x:Name="ResultCountText"
                                   Text="Busque uma banda, música, álbum ou charter"
                                   Foreground="#A9B3BD" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Ordenar por:" Foreground="#8994A0" FontSize="11"/>
                            <ComboBox x:Name="SortCombo" Style="{StaticResource DarkCombo}"
                                      Width="150" Height="34" Margin="10,0,0,0"
                                      SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="Scroller" Grid.Row="2"
                                  VerticalScrollBarVisibility="Hidden"
                                  ScrollChanged="Scroller_ScrollChanged">
                        <ItemsControl x:Name="Results">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="79" Background="#EB111C26" BorderBrush="#3B4955"
                                            BorderThickness="1" CornerRadius="8" Margin="0,0,6,5"
                                            Padding="10,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="175"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="54" Height="54" HorizontalAlignment="Center">
                                                <Border CornerRadius="5" Background="#080C11">
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,54,54" RadiusX="5" RadiusY="5"/>
                                                    </Border.Clip>
                                                    <Image Source="{Binding ArtUrl}" Stretch="UniformToFill"
                                                           ImageFailed="AlbumArt_ImageFailed"/>
                                                </Border>
                                                <Border Background="{Binding OwnedBadgeBrush}" Height="15"
                                                        VerticalAlignment="Top" Margin="-7,-7,0,0"
                                                        HorizontalAlignment="Left" Padding="5,0">
                                                    <TextBlock Text="{Binding OwnedBadgeText}" Foreground="#17130B"
                                                               FontSize="7" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="12,0,12,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" Foreground="#E4E9ED"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding VideoText}" Margin="8,2,0,0"
                                                               Foreground="{StaticResource Gold}" FontSize="9"
                                                               FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="#9AA5B0"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                                    <Run Text="{Binding Artist, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Genre, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="Charter" Foreground="#7E8995" FontSize="10"/>
                                                <TextBlock Text="{Binding Charter}" Foreground="{StaticResource Blue}"
                                                           FontSize="11" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="Dificuldade" Foreground="#7E8995" FontSize="10"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding DifficultyVisual}"
                                                               Foreground="{StaticResource Gold}" FontSize="13"/>
                                                    <TextBlock Text="{Binding DiffText}" Foreground="{StaticResource Gold}"
                                                               FontSize="11" FontWeight="Bold" Margin="8,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="Duração" Foreground="#7E8995" FontSize="10"/>
                                                <TextBlock Text="{Binding LengthText}" Foreground="{StaticResource Blue}"
                                                           FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="5" Style="{StaticResource GhostButton}"
                                                    Margin="0,7,12,7" Padding="10,6"
                                                    Click="Preview_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource IconPlay}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Prévia" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="6" Style="{StaticResource GoldButton}"
                                                    Margin="0,7,0,7" Padding="11,6"
                                                    Click="Download_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource IconDownload}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" Fill="Transparent"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding DownloadText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- fila inferior igual ao mockup -->
                    <Border x:Name="DownloadTray" Grid.Row="3" Background="#EE0E161F"
                            BorderBrush="{StaticResource GoldDim}" BorderThickness="1"
                            CornerRadius="9" Margin="0,4,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="18,0,12,0">
                                <TextBlock x:Name="DownloadCountText" Text="Fila de downloads (0)"
                                           Foreground="{StaticResource Gold}" FontSize="13"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="IncludeVideoCheck" Style="{StaticResource ToggleCheck}"
                                              Content="Incluir vídeo quando houver" Margin="0,0,16,0"/>
                                    <Button x:Name="ScanBtn" Style="{StaticResource GhostButton}"
                                            Content="Scan completo" Padding="12,6"
                                            Click="Scan_Click"/>
                                </StackPanel>
                                <ProgressBar x:Name="DlBar" Height="3" VerticalAlignment="Bottom"
                                             Background="#202C36" Foreground="{StaticResource Gold}"
                                             BorderThickness="0" Visibility="Collapsed"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <StackPanel x:Name="DownloadEmptyText" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Orientation="Horizontal" Opacity=".72">
                                    <Image Source="Assets/App/backstage-mark-v2.png" Width="54" Height="34"
                                           Stretch="Uniform" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sua fila está vazia" Foreground="#A3ADB7"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Os próximos downloads aparecem aqui."
                                                   Foreground="#66737F" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="DownloadResults">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="51" Background="#8F15202A"
                                                        BorderBrush="#35414C" BorderThickness="1"
                                                        CornerRadius="6" Margin="9,0,9,5" Padding="8,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="260"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="220"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="4">
                                                            <Border.Clip>
                                                                <RectangleGeometry Rect="0,0,36,36" RadiusX="4" RadiusY="4"/>
                                                            </Border.Clip>
                                                            <Image Source="{Binding ArtUrl}" Stretch="UniformToFill"
                                                                   ImageFailed="AlbumArt_ImageFailed"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   VerticalAlignment="Center" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Charter}"
                                                                   VerticalAlignment="Center" Foreground="{StaticResource Blue}"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        <Grid Grid.Column="3" Margin="12,0">
                                                            <ProgressBar Height="8" Maximum="100"
                                                                         Value="{Binding Progress, Mode=OneWay}"
                                                                         Background="#26323D"
                                                                         Foreground="{StaticResource Gold}"
                                                                         BorderThickness="0"/>
                                                            <TextBlock Text="{Binding State}" FontSize="9"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProgressText}" Width="82"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="#919CA7" FontSize="10"/>
                                                            <Button Content="{Binding ScanText}" Margin="6,0,0,0"
                                                                    Padding="8,4"
                                                                    Style="{StaticResource GhostButton}"
                                                                    IsEnabled="{Binding CanScan}"
                                                                    Click="ScanDownload_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- HIGHWAYS -->
                <Grid x:Name="HighwayView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#E80C141D" BorderBrush="#4B5965"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HIGHWAYS" Foreground="{StaticResource Gold}"
                                           FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Escolha a sua estrada" FontSize="21"
                                           FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Restaurar jogo"
                                        Margin="0,0,8,0" Click="ResetHighway_Click"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Abrir pasta do jogo" Click="OpenHighwaysFolder_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock Text="68 highways · loops verticais · catálogo compacto embutido"
                                   Foreground="#AAB4BE" VerticalAlignment="Center" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="PersistHighwayCheck" Style="{StaticResource ToggleCheck}"
                                      Content="Manter como padrão" IsChecked="True" Margin="0,0,14,0"
                                      ToolTip="Reaplica automaticamente nas próximas músicas e ao abrir o jogo"/>
                            <Border Background="#2239C975" BorderBrush="#455DC78B"
                                    BorderThickness="1" CornerRadius="14" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Green}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="APPLY AO VIVO" Foreground="{StaticResource Green}"
                                               FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="HighwayResults">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="194" Margin="0,0,12,12" Padding="11"
                                            Background="#EB111C26" BorderBrush="#46525D"
                                            BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <Border Width="170" Height="340" Background="#080A0E"
                                                    BorderBrush="#66717C" BorderThickness="1"
                                                    CornerRadius="7">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,170,340" RadiusX="7" RadiusY="7"/>
                                                </Border.Clip>
                                                <Image Source="{Binding ResourcePath}" Stretch="Fill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       FontWeight="SemiBold" Margin="2,9,2,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Style}" Foreground="#8995A1"
                                                       FontSize="10" Margin="2,2,2,8"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Style="{StaticResource GoldButton}"
                                                    Content="Aplicar ao vivo" Padding="10,7"
                                                    Click="ApplyHighway_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- BACKGROUNDS -->
                <Grid x:Name="BackgroundView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#E80C141D" BorderBrush="#4B5965"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="148"/>
                                <ColumnDefinition x:Name="BgQualityColumn" Width="173"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="188"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BgSearchBox" Style="{StaticResource SearchBox}"
                                     Tag="Buscar backgrounds" KeyDown="BgSearchBox_KeyDown"/>
                            <ComboBox x:Name="BgTypeCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                                      Margin="8,0,0,0" SelectedIndex="0"
                                      SelectionChanged="BgQualityCombo_SelectionChanged"/>
                            <ComboBox x:Name="BgQualityCombo" Grid.Column="2" Style="{StaticResource DarkCombo}"
                                      Margin="8,0,0,0" SelectedIndex="0"
                                      SelectionChanged="BgQualityCombo_SelectionChanged"/>
                            <Button x:Name="BgSearchBtn" Grid.Column="3" Style="{StaticResource GoldButton}"
                                    Content="Buscar" Height="44" Padding="12,0" Margin="8,0,0,0"
                                    Click="SearchBackgrounds_Click"/>
                            <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                                    Content="Importar arquivo local" Height="44" Padding="12,0"
                                    Margin="8,0,0,0"
                                    Click="ImportBackground_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#241C8ED6" BorderBrush="#454E7890"
                                    BorderThickness="1" CornerRadius="12" Padding="10,4">
                                <TextBlock Text="16:9 WIDESCREEN" Foreground="{StaticResource Blue}"
                                           FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#2239C975" BorderBrush="#455DC78B"
                                    BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="8,0,0,0">
                                <TextBlock Text="APPLY AO VIVO" Foreground="{StaticResource Green}"
                                           FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <CheckBox x:Name="PersistBackgroundCheck" Style="{StaticResource ToggleCheck}"
                                      Content="Manter como padrão" IsChecked="True" Margin="12,0,0,0"
                                      ToolTip="Reaplica automaticamente nas próximas músicas e ao abrir o jogo"/>
                            <TextBlock x:Name="BgResultText" Text="Filtros aplicados automaticamente"
                                       Foreground="#7E8A96" FontSize="11" Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ProgressBar x:Name="BgLoadBar" Width="120" Height="3" Margin="0,0,8,0"
                                         IsIndeterminate="True" BorderThickness="0"
                                         Background="#202C36" Foreground="{StaticResource Gold}"
                                         Visibility="Collapsed"/>
                            <Button x:Name="BgMoreBtn" Style="{StaticResource GhostButton}"
                                    Content="Carregar mais" Padding="12,6" Margin="0,0,8,0"
                                    Visibility="Collapsed" Click="BgMoreBtn_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Restaurar jogo"
                                    Padding="12,6" Click="ResetBackground_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border x:Name="BgEmptyState" Width="700" Height="270"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#E6111923" BorderBrush="#786338"
                                BorderThickness="1" CornerRadius="14" Padding="34">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="Assets/App/backstage-mark-v2.png" Width="94" Height="60"
                                       Stretch="Uniform" HorizontalAlignment="Left"/>
                                <TextBlock Text="Catálogo de backgrounds" FontSize="25"
                                           FontWeight="SemiBold" Margin="0,12,0,0"/>
                                <TextBlock Margin="0,8,0,18" Foreground="#8F9AA5"
                                           TextWrapping="Wrap" LineHeight="19"
                                           Text="Pesquise dentro do Backstage. Vídeos 1080p são priorizados e convertidos para WebM compatível ao aplicar."/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Green}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="APLICAÇÃO AO VIVO" Foreground="{StaticResource Green}"
                                               FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="BgScroller" VerticalScrollBarVisibility="Hidden"
                                      ScrollChanged="BgScroller_ScrollChanged">
                            <ItemsControl x:Name="BackgroundResults">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="294" Margin="0,0,12,12" Padding="9"
                                                Background="#ED111C26" BorderBrush="#46525D"
                                                BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <Border Width="274" Height="154" Background="#080A0E"
                                                        BorderBrush="#56636F" BorderThickness="1"
                                                        CornerRadius="7">
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,274,154" RadiusX="7" RadiusY="7"/>
                                                    </Border.Clip>
                                                    <Grid MouseEnter="BackgroundPreview_MouseEnter"
                                                          MouseLeave="BackgroundPreview_MouseLeave">
                                                        <Image Source="{Binding PreviewSource}" Stretch="UniformToFill"/>
                                                        <MediaElement x:Name="BackgroundVideoPreview"
                                                                      LoadedBehavior="Manual"
                                                                      UnloadedBehavior="Manual"
                                                                      IsMuted="True" Stretch="UniformToFill"
                                                                      IsHitTestVisible="False" Opacity="0"
                                                                      MediaOpened="BackgroundPreview_MediaOpened"
                                                                      MediaFailed="BackgroundPreview_MediaFailed"/>
                                                    </Grid>
                                                </Border>
                                                <Grid Margin="2,8,2,7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                                   Foreground="#DCE3E9" FontWeight="SemiBold"
                                                                   Margin="0,0,46,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Meta}" Foreground="#788591"
                                                                   FontSize="10" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Background="#2AF6C34A" CornerRadius="10" Padding="7,3">
                                                        <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Gold}"
                                                                   FontSize="8" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource GoldButton}"
                                                            Content="{Binding ActionText}"
                                                            Padding="10,7"
                                                            Click="ApplyBackgroundResult_Click"/>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                            Content="Excluir" Foreground="#FF9A9A"
                                                            Padding="10,7" Margin="7,0,0,0"
                                                            Visibility="{Binding DeleteVisibility}"
                                                            Click="DeleteBackgroundResult_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- SKINS COMPLETAS -->
                <Grid x:Name="SkinView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#E80C141D" BorderBrush="#4B5965"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SKINS" Foreground="{StaticResource Gold}"
                                           FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Troque as notas de verdade" FontSize="21"
                                           FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Restaurar jogo"
                                        Margin="0,0,8,0" Click="ResetSkin_Click"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Abrir pasta de skins" Click="OpenSkinsFolder_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock MaxWidth="840" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Text="Normal = palhetada · HOPO = hammer-on/pull-off · Tap = sem palhetar · Ghost = transparência nativa · Sustain = barra nativa na cor do tema"
                                   Foreground="#AAB4BE" VerticalAlignment="Center" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="ApplySkinHighwayCheck" Style="{StaticResource ToggleCheck}"
                                      Content="Highway combinando" IsChecked="True" Margin="0,0,14,0"
                                      ToolTip="Instala e aplica a highway criada para este tema"/>
                            <CheckBox x:Name="PersistSkinCheck" Style="{StaticResource ToggleCheck}"
                                      Content="Manter como padrão" IsChecked="True" Margin="0,0,14,0"
                                      ToolTip="Reaplica nas próximas músicas e ao abrir o jogo"/>
                            <Border Background="#2239C975" BorderBrush="#455DC78B"
                                    BorderThickness="1" CornerRadius="14" Padding="12,5">
                                <TextBlock Text="SPRITES REAIS" Foreground="{StaticResource Green}"
                                           FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="SkinResults">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="382" Margin="0,0,12,12" Padding="14"
                                            Background="#ED111C26" BorderBrush="#46525D"
                                            BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="15"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Style}" Foreground="#8995A1"
                                                       FontSize="10" Margin="0,2,0,10"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Height="142" Background="#BE080E15" BorderBrush="#374653"
                                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,9">
                                                <UniformGrid Columns="3" Rows="2" Margin="8">
                                                    <StackPanel Margin="3">
                                                        <Image Source="{Binding StandardPath}" Height="42" Stretch="Uniform"/>
                                                        <TextBlock Text="NORMAL" HorizontalAlignment="Center"
                                                                   Foreground="#82909C" FontSize="8"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="3">
                                                        <Image Source="{Binding HopoPath}" Height="42" Stretch="Uniform"/>
                                                        <TextBlock Text="HOPO" HorizontalAlignment="Center"
                                                                   Foreground="#82909C" FontSize="8"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="3">
                                                        <Image Source="{Binding TapPath}" Height="42" Stretch="Uniform"/>
                                                        <TextBlock Text="TAP" HorizontalAlignment="Center"
                                                                   Foreground="#82909C" FontSize="8"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="3">
                                                        <Image Source="{Binding StarPath}" Height="42" Stretch="Uniform"/>
                                                        <TextBlock Text="STAR" HorizontalAlignment="Center"
                                                                   Foreground="#82909C" FontSize="8"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="3">
                                                        <Image Source="{Binding OpenPath}" Height="42" Stretch="Uniform"/>
                                                        <TextBlock Text="OPEN" HorizontalAlignment="Center"
                                                                   Foreground="#82909C" FontSize="8"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="3">
                                                        <Image Source="{Binding FretPath}" Height="42" Stretch="Uniform"/>
                                                        <TextBlock Text="FRET / BOTÃO" HorizontalAlignment="Center"
                                                                   Foreground="#82909C" FontSize="8"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Border>
                                            <UniformGrid Columns="5" Height="8" Margin="0,0,0,11">
                                                <Border Background="{Binding Green}" CornerRadius="3" Margin="2,0"/>
                                                <Border Background="{Binding Red}" CornerRadius="3" Margin="2,0"/>
                                                <Border Background="{Binding Yellow}" CornerRadius="3" Margin="2,0"/>
                                                <Border Background="{Binding Blue}" CornerRadius="3" Margin="2,0"/>
                                                <Border Background="{Binding Orange}" CornerRadius="3" Margin="2,0"/>
                                            </UniformGrid>
                                            <Button Style="{StaticResource GoldButton}"
                                                    Content="Instalar e aplicar" Padding="10,7"
                                                    Click="ApplySkin_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- PRESETS DE VISUAIS -->
                <Grid x:Name="PresetView" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#E80C141D" BorderBrush="#4B5965"
                            BorderThickness="1" CornerRadius="12" Padding="18,14">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PRESETS" Foreground="{StaticResource Gold}"
                                           FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Skin + background + highway" FontSize="21"
                                           FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBox x:Name="PresetNameBox" Width="260" Height="40"
                                         Padding="12,0" VerticalContentAlignment="Center"
                                         Background="#D7091119" Foreground="#EEF2F5"
                                         BorderBrush="#596775" BorderThickness="1"
                                         CaretBrush="{StaticResource Gold}"
                                         ToolTip="Nome do novo preset"/>
                                <Button Style="{StaticResource GoldButton}" Content="Salvar atual"
                                        Height="40" Padding="18,0" Margin="8,0,0,0"
                                        Click="SavePreset_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="PresetCountText" Text="Nenhum preset salvo"
                                   Foreground="#AAB4BE" VerticalAlignment="Center" FontSize="12"/>
                        <CheckBox x:Name="PresetPersistCheck" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Style="{StaticResource ToggleCheck}"
                                  Content="Manter após reiniciar" IsChecked="True"
                                  ToolTip="Define os três itens do preset como padrão do jogo"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="PresetResults">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="370" Margin="0,0,12,12" Padding="16"
                                            Background="#ED111C26" BorderBrush="#46525D"
                                            BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="17"
                                                       FontWeight="SemiBold" Margin="0,0,0,12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="SKIN" Foreground="{StaticResource Gold}"
                                                           FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SkinLabel}"
                                                           Foreground="#C4CDD5" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BACKGROUND" Foreground="{StaticResource Gold}"
                                                           FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding BackgroundLabel}"
                                                           Foreground="#C4CDD5" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="HIGHWAY" Foreground="{StaticResource Gold}"
                                                           FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding HighwayLabel}"
                                                           Foreground="#C4CDD5" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource GoldButton}" Content="Aplicar"
                                                        Padding="14,7" Click="ApplyPreset_Click"/>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                        Content="Excluir" Foreground="#FF9A9A"
                                                        Padding="14,7" Margin="8,0,0,0"
                                                        Click="DeletePreset_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
